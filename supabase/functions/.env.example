# Copy to supabase/functions/.env.local for `supabase functions serve --env-file`,
# or set them as secrets for a deployed project:
#   supabase secrets set --env-file supabase/functions/.env.production
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.

# Required. Password the admin panel sends in the X-Admin-Password header.
MDPC_ADMIN_PASSWORD=change-me

# Comma-separated full origins (scheme + host + port) allowed to call the functions from a browser.
MDPC_ALLOWED_ORIGINS=https://admin.example.com,http://localhost:5173

# Comma-separated post categories (A-Z, 0-9, _ and -). Default: BLOG
MDPC_POST_CATEGORIES=BLOG,NEWS

# Storage buckets. Defaults: post-images and temp
MDPC_POSTS_BUCKET=post-images
MDPC_TEMP_BUCKET=temp

# Optional. Public base URL of Storage used in the URLs the functions return.
# Leave empty on a hosted project; set it for `supabase functions serve`, where
# SUPABASE_URL is the Docker-internal host (http://kong:8000) browsers can't reach.
MDPC_PUBLIC_STORAGE_URL=http://127.0.0.1:54321/storage/v1/object/public
