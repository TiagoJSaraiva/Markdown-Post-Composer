# Copy to .env.local and adjust. All variables are read at build/dev time.

# Base URL of the Edge Functions (required).
#   hosted: https://<ref>.supabase.co/functions/v1
#   local:  http://127.0.0.1:54321/functions/v1
VITE_MDPC_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# Public base URL of Supabase Storage (required).
#   hosted: https://<ref>.supabase.co/storage/v1/object/public
#   local:  http://127.0.0.1:54321/storage/v1/object/public
VITE_MDPC_STORAGE_PUBLIC_URL=http://127.0.0.1:54321/storage/v1/object/public

# Bucket that holds published post images (default: post-images).
VITE_MDPC_POSTS_BUCKET=post-images

# Comma-separated post categories (default: BLOG).
# Must match MDPC_POST_CATEGORIES of the functions.
VITE_MDPC_POST_CATEGORIES=BLOG

# UI language: en | pt-BR (default: en).
VITE_MDPC_LOCALE=en

# Public website URL. The "open website" button is hidden when empty.
VITE_MDPC_SITE_URL=

# Browser tab title (default: MD Post Composer).
VITE_MDPC_APP_TITLE=MD Post Composer
