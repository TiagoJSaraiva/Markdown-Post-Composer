{
  "name": "md-post-composer",
  "private": true,
  "version": "0.1.0",
  "description": "Pluggable Markdown post composer: Supabase Edge Functions API + React admin panel.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm -C admin dev",
    "build": "pnpm -C admin build",
    "lint": "pnpm -C admin lint",
    "test": "pnpm -C shared test && pnpm test:functions",
    "test:functions": "deno test --allow-env --allow-read --config supabase/functions/_tests/deno.json supabase/functions/_tests",
    "supabase": "supabase"
  },
  "devDependencies": {
    "supabase": "^2.77.0"
  }
}
